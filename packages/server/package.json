{
  "name": "@gridcommander/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R src/store/migrations dist/store/",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@gridcommander/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "nanoid": "6.0.2",
    "pino": "10.4.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "ws": "8.22.0"
  }
}
